<Window x:Class="GhostPrompter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GhostPrompter.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GhostPrompter" Width="760" Height="640" MinWidth="620" MinHeight="500"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <TextBlock Text="GhostPrompter — Configuration" VerticalAlignment="Center" Margin="14,0" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="—" Click="OnMinimizeClick" ToolTip="Minimize" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="×" Click="OnCloseClick" ToolTip="Close" />
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="GhostPrompter" />
                    <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="Source" FontWeight="Bold"/><TextBlock Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Load" Command="{Binding LoadCommand}"/><Button Content="Reload" Command="{Binding ReloadCommand}" Margin="8,0,0,0"/><Button Content="Cancel" Command="{Binding CancelLoadCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0"><TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Width="130" SelectedValuePath="Tag" SelectedValue="{Binding Mode}"><ComboBoxItem Content="Blocks" Tag="{x:Static models:PrompterMode.Blocks}"/><ComboBoxItem Content="Scroll" Tag="{x:Static models:PrompterMode.Scroll}"/></ComboBox></StackPanel>
                    <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Display" FontWeight="Bold"/><TextBlock Text="Font size" Margin="0,10,0,0"/><Slider Minimum="16" Maximum="72" Value="{Binding FontSize}"/><TextBlock Text="Background opacity"/><Slider Minimum="0" Maximum="100" Value="{Binding BackgroundOpacity}"/><TextBlock Text="Text opacity"/><Slider Minimum="20" Maximum="100" Value="{Binding TextOpacity}"/><CheckBox Content="Show titles" IsChecked="{Binding ShowTitles}"/><CheckBox Content="Show progress" IsChecked="{Binding ShowProgress}"/></StackPanel><StackPanel Grid.Column="1" Margin="30,0,0,0"><TextBlock Text="Scroll" FontWeight="Bold"/><TextBlock Text="Speed (DIP/s)" Margin="0,10,0,0"/><Slider Minimum="10" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding ScrollSpeed}"/><TextBlock Text="Starting height (%)"/><Slider Minimum="10" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding StartingHeight}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Play / Pause" Command="{Binding TogglePlayPauseCommand}"/><Button Content="Restart" Command="{Binding RestartCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel></Grid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Previous" Command="{Binding PreviousPageCommand}"/><Button Content="Next" Command="{Binding NextPageCommand}" Margin="8,0,0,0"/><Button Content="Show / Hide" Command="{Binding ToggleVisibilityCommand}" Margin="8,0,0,0"/><Button Content="Configuration / Presentation" Command="{Binding TogglePresentationCommand}" Margin="8,0,0,0"/><Button Content="Click Through" Command="{Binding ToggleClickThroughCommand}" Margin="8,0,0,0"/><Button Content="Reset window position" Command="{Binding ResetWindowPositionCommand}" Margin="8,0,0,0"/></StackPanel>
                    <Border Grid.Row="5" Margin="0,18,0,0" Padding="12" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"><StackPanel><TextBlock Text="Status" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding PresentationStatus}" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding CaptureStatus}" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding SettingsStatus}" Foreground="#F0883E" TextWrapping="Wrap"/><Button Content="Restore default shortcuts" Command="{Binding RestoreDefaultShortcutsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
                    <TextBlock Grid.Row="6" Margin="0,18,0,0" Text="Default shortcuts: Ctrl+Alt+Up/Down, P, Space, L, T, Add/Subtract, Plus/Minus and Home." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
